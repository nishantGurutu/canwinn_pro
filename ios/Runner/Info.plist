<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Task Management</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>task_management</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- 🔐 Permissions -->
	<key>NSCalendarsUsageDescription</key>
	<string>This app needs access to your calendar.</string>

	<key>NSCameraUsageDescription</key>
	<string>This app needs access to your camera to take photos or scan QR codes.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs access to your microphone for recording audio.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app needs access to your location while the app is in use.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app requires location access in the background to provide continuous services.</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app uses Bluetooth to connect to nearby devices.</string>

	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>This app uses Bluetooth to communicate with nearby peripherals.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to your photo library to select and upload photos.</string>

	<key>NSUserTrackingUsageDescription</key>
	<string>This app uses your device identifier to deliver personalized ads and analytics.</string>

	<key>NSMotionUsageDescription</key>
	<string>This app uses motion data for activity tracking and related features.</string>

	<key>NSRemindersUsageDescription</key>
	<string>This app needs access to your reminders for task management.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app uses speech recognition to convert your voice into text.</string>

	<!-- Notifications (iOS asks via code, but adding helps App Store review) -->
	<key>NSUserNotificationUsageDescription</key>
	<string>This app sends you notifications to keep you updated.</string>
</dict>
</plist>
